# Supabase — Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by server actions for form inserts; never expose as
# NEXT_PUBLIC_* and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Form notifications: Google Apps Script web app endpoint that appends a
# sheet row and emails the owner. Optional — forms still save without it.
GOOGLE_SCRIPT_URL=

# Phase 2 — payments. Do not enable without the Fortis compliance
# conversation (PROJECT_BRIEF.md section 12).
# FORTIS_API_KEY=
# FORTIS_LOCATION_ID=
