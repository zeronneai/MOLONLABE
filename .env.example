# Supabase — Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by server actions for form inserts; never expose as
# NEXT_PUBLIC_* and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin, no trailing slash (e.g. https://molonlabefirearms.com).
# Read at BUILD time by robots.txt and sitemap.xml, so set it before the
# build, not after. Feeds every canonical, JSON-LD @id and OG image URL.
NEXT_PUBLIC_SITE_URL=

# GA4 measurement id (G-XXXXXXXXXX). Unset, no analytics script loads at
# all — leave it blank on previews to keep them out of the client's data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Form notifications: Google Apps Script web app endpoint that appends a
# sheet row and emails the owner. Optional — forms still save without it.
GOOGLE_SCRIPT_URL=

# Payments — Authorize.net via Accept.js.
#
# Card data goes from the browser straight to Authorize.net and comes back
# as a one-time nonce; only that nonce reaches this server. Nothing here
# lets anything read or replay a card.
#
# sandbox | production. This picks BOTH the API endpoint and the Accept.js
# script, so it is the one variable that decides whether real cards are
# charged. Set it deliberately.
NEXT_PUBLIC_AUTHORIZENET_ENV=sandbox

# Merchant API Login ID. Public — the browser needs it to tokenize.
AUTHORIZENET_API_LOGIN_ID=

# Transaction Key. SECRET. Server-only, never NEXT_PUBLIC_*, never
# committed. Anyone holding this can charge and refund at will.
AUTHORIZENET_TRANSACTION_KEY=

# Public Client Key, from Account -> Manage Public Client Key. Public by
# design: it can only create nonces, never charge.
NEXT_PUBLIC_AUTHORIZENET_CLIENT_KEY=

# Test only. Points the gateway call at a local double so the checkout can
# be exercised without reaching Authorize.net. Ignored when
# NEXT_PUBLIC_AUTHORIZENET_ENV=production, so it cannot redirect a live
# charge. Leave unset everywhere else.
# AUTHORIZENET_API_BASE=

# Which transport carries the customer's order confirmation.
#   apps_script  (default, and what unset means) — hands the rendered
#                email to GOOGLE_SCRIPT_URL below with a kind of
#                order_confirmation. Free, no domain needed, subject to
#                Gmail's daily send cap.
#   resend       — needs a verified sending domain. Better deliverability
#                and no cap; move to this once the client has a domain.
# Nothing else changes when this moves: both send the same rendered HTML.
EMAIL_PROVIDER=apps_script

# Only needed when EMAIL_PROVIDER=resend. Without both, the order still
# completes and is recorded; the email is skipped and the order row keeps
# confirmation_sent_at null so the owner can see which ones need sending
# by hand.
RESEND_API_KEY=
# Under apps_script this is optional, and is only honoured if the Google
# account has it as a verified alias. Unset, the script sends from the
# account's own address.
ORDER_EMAIL_FROM=

# Test only, and the twins of AUTHORIZENET_API_BASE above. Point a send at
# a local double so the confirmation email can be asserted on as it is
# actually rendered. Only honoured for a localhost address — anything else
# is ignored and the real endpoint is used, so a stray value cannot
# quietly divert customer mail. Leave both unset everywhere else.
# RESEND_API_BASE=
# GOOGLE_SCRIPT_BASE=
